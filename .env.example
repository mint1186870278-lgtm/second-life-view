# Domestic mainland endpoints only
DASHSCOPE_API_KEY=
DASHSCOPE_BASE_URL=https://ws-tjdprzo19lrbrhsy.cn-beijing.maas.aliyuncs.com/compatible-mode/v1
DASHSCOPE_API_HOST=https://ws-tjdprzo19lrbrhsy.cn-beijing.maas.aliyuncs.com
DASHSCOPE_TEXT_MODEL=deepseek-v4-pro
DASHSCOPE_VISION_MODEL=qwen3.8-max
DASHSCOPE_IMAGE_MODEL=qwen-image-3.0-pro
DASHSCOPE_IMAGE_ASYNC=false
DASHSCOPE_IMAGE_TIMEOUT=240
DASHSCOPE_CHAT_TIMEOUT=120
LUX3D_API_KEY=
AHOLO_API_KEY=
TRIPO_API_KEY=
TRIPO_BASE_URL=https://openapi.tripo3d.com/v3
OSS_ACCESS_KEY_ID=
OSS_ACCESS_KEY_SECRET=
OSS_BUCKET=
# e.g. oss-cn-hangzhou.aliyuncs.com (do not include the bucket name)
OSS_ENDPOINT=oss-cn-hangzhou.aliyuncs.com
OSS_REGION=cn-hangzhou
OSS_PREFIX=second-life-view
OSS_SIGNED_URL_TTL=3600
OSS_MAX_UPLOAD_MB=1024
# Required only when the Windows host pushes completed JPEGs directly to
# POST /api/v1/camera/ingest. Use a distinct, high-entropy bearer token.
CAMERA_INGEST_TOKEN=
CAMERA_INGEST_MAX_UPLOAD_MB=256
# Live Linux-side YOLO-World settings. "auto" uses CUDA:0 when available.
YOLO_WEIGHTS=
YOLO_DEVICE=auto
YOLO_CONFIDENCE=0.12
YOLO_VIEW_SIZE=768
YOLO_FOV_DEG=90
# Set only after the Windows CameraSDK bridge and SSH reverse tunnel are up.
# Keep this loopback address: the tunnel makes it reach the Windows machine.
WINDOWS_CAMERA_GATEWAY_URL=http://127.0.0.1:18081
WINDOWS_CAMERA_GATEWAY_TOKEN=
WINDOWS_CAMERA_GATEWAY_TIMEOUT=720
LUX3D_REGION=cn
LUX3D_BASE_URL=https://api.aholo3d.cn
USE_LLM=false
USE_EXTERNAL_TOOLS=false
# Set true only when web search is explicitly desired; local RAG is always available.
RESEARCH_WEB_ENABLED=false
