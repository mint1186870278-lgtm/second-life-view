# Absolute Windows path to the CMake-built executable.
CAMERA_BRIDGE_EXECUTABLE=C:/Insta360Bridge/build/Release/camera_bridge_cli.exe

# Keep this directory on a local NTFS volume with sufficient free space.
CAMERA_BRIDGE_OUTPUT_DIR=C:/Insta360Bridge/captures

# Use a new random secret shared only with the Linux server.
CAMERA_BRIDGE_TOKEN=replace-with-a-long-random-secret

# CameraSDK's internal download service port. Change only when 9099 is occupied.
CAMERA_BRIDGE_SERVICE_PORT=9099

# Optional: bind one gateway instance to a specific camera.
CAMERA_BRIDGE_CAMERA_SERIAL=

# Optional: MediaSDK model directory. TEMPLATE stitching works without an AI model,
# but this should normally be the copied `bin/models` directory beside MediaSDK.dll.
CAMERA_BRIDGE_MEDIA_MODELS_DIR=C:/Insta360Bridge/build/Release/models
