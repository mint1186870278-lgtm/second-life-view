#!/usr/bin/env bash
# Start Codex for this repository using the globally signed-in ChatGPT account.
# Keep YOLO permissions for this repository without loading an API credential.
set -euo pipefail

codex_binary="$(command -v codex)"

if [[ -z "$codex_binary" ]]; then
  printf 'Codex executable is unavailable on PATH.\n' >&2
  exit 1
fi

exec "$codex_binary" --dangerously-bypass-approvals-and-sandbox "$@"
